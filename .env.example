# Local Python server
HOST=127.0.0.1
PORT=8000
ADMIN_INITIAL_PASSWORD=ganti-password-kuat

# Vercel serverless API
# Buat Neon/Postgres dari Vercel Marketplace, lalu isi DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Buat Vercel Blob dari tab Storage, token ini biasanya otomatis terpasang.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# public lebih mudah untuk sementara; private lebih aman tetapi butuh flow download token.
BLOB_ACCESS=public
