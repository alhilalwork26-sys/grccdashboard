# Local Python server
HOST=127.0.0.1
PORT=8000
ADMIN_INITIAL_PASSWORD=ganti-password-kuat

# Vercel serverless API
# Buat Neon/Postgres dari Vercel Marketplace, lalu isi DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Buat Vercel Blob dari tab Storage, token ini biasanya otomatis terpasang.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Gunakan private untuk dokumen sensitif. File akan diambil lewat API setelah login dicek.
# Untuk store Blob private, buat lewat Vercel: vercel blob create-store nama-store --access private
BLOB_ACCESS=private
DOCUMENT_BLOB_ACCESS=private

# Vercel Cron + WhatsApp reminder progres harian
# 10:00 WIB = 03:00 UTC, 16:00 WIB = 09:00 UTC di vercel.json.
CRON_SECRET=buat-secret-panjang-random

# Pilihan 1: Fonnte
FONNTE_TOKEN=token_fonnte_anda
# Opsional jika endpoint Fonnte berubah
FONNTE_API_URL=https://api.fonnte.com/send

# Pilihan 2: webhook WhatsApp custom. Jika ini diisi, sistem memakai webhook ini.
# WHATSAPP_WEBHOOK_URL=https://example.com/send-whatsapp
# WHATSAPP_TOKEN=token_webhook_anda
