# Local Python server
HOST=127.0.0.1
PORT=8000
ADMIN_INITIAL_PASSWORD=ganti-password-kuat

# Vercel serverless API
# Buat Neon/Postgres dari Vercel Marketplace, lalu isi DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Buat Vercel Blob dari tab Storage, token ini biasanya otomatis terpasang.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Gunakan private untuk dokumen sensitif. File akan diambil lewat API setelah login dicek.
# Untuk store Blob private, buat lewat Vercel: vercel blob create-store nama-store --access private
BLOB_ACCESS=private
DOCUMENT_BLOB_ACCESS=private

# CUK AI (Cepat Urus Kerjaan AI)
# Jika kosong, CUK AI tetap membuat ringkasan sederhana dari teks dokumen,
# tetapi belum memakai AI OpenAI sungguhan.
OPENAI_API_KEY=sk-isi-api-key-openai
OPENAI_SUMMARY_MODEL=gpt-5.4-mini

# Alternatif gratis/lebih hemat untuk CUK AI.
# Jika OPENAI_API_KEY kosong tetapi GEMINI_API_KEY ada, CUK AI memakai Gemini.
GEMINI_API_KEY=AIza-isi-api-key-gemini
GEMINI_SUMMARY_MODEL=gemini-1.5-flash

# Opsional: mirror upload dokumen ke Google Drive perusahaan.
# Akun Drive pemilik folder: crbpascaunair@gmail.com
# Buat Service Account di Google Cloud, share folder Drive ke email service account sebagai Editor.
GOOGLE_DRIVE_FOLDER_ID=id_folder_google_drive_root
# Lebih aman pakai base64 JSON credential service account agar private_key tidak rusak di Vercel env.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON_BASE64=base64_dari_file_service_account_json

# Vercel Cron + WhatsApp reminder progres harian
# 10:00 WIB = 03:00 UTC, 16:00 WIB = 09:00 UTC di vercel.json.
CRON_SECRET=buat-secret-panjang-random

# Pilihan 1: Fonnte
FONNTE_TOKEN=token_fonnte_anda
# Opsional jika endpoint Fonnte berubah
FONNTE_API_URL=https://api.fonnte.com/send

# Pilihan 2: webhook WhatsApp custom. Jika ini diisi, sistem memakai webhook ini.
# WHATSAPP_WEBHOOK_URL=https://example.com/send-whatsapp
# WHATSAPP_TOKEN=token_webhook_anda
